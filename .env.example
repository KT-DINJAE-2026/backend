# 공공데이터포털에서 발급받은 일반 인증키(Encoding 또는 Decoding)를 사용합니다.
SEOUL_BUS_API_KEY=
SEOUL_BUS_API_ENABLED=true

# Open-Meteo는 인증키가 필요하지 않습니다. 장애 시 PREDICTION_DEFAULT_WEATHER로 폴백합니다.
WEATHER_API_ENABLED=true
PREDICTION_DEFAULT_WEATHER=맑음

# AI 배치 CSV를 적재할 때만 경로를 설정합니다.
PREDICTION_IMPORT_FILE=
PREDICTION_SAMPLE_BASIS=BOARDING_STOP
PREDICTION_USER_TYPE_MODE=FIXED
PREDICTION_USER_TYPE_CODE=04
